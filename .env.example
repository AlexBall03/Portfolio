# ---------------------------------------------------------------------------
# Server-only unless prefixed NEXT_PUBLIC_ (only Clerk's publishable key,
# which is public by design). Validated at runtime by src/config/env.ts.
# ---------------------------------------------------------------------------

# Neon Postgres. The Vercel <-> Neon integration sets both automatically, per
# environment (Production -> main, Preview -> a branch created per deployment).
# Locally, use the DEV branch's values here, never Production's: `npm run dev`
# applies pending migrations to this database before starting.
# Both must point at the SAME database; the db:* scripts refuse to run otherwise.
# This file is ignored on Vercel and in CI.
# Pooled connection string — used by the app (Neon serverless HTTP driver).
DATABASE_URL=
# Direct connection string — used by db:prepare / db:migrate / db:seed / db:studio.
DATABASE_URL_UNPOOLED=

# GitHub token (fine-grained, public read-only is enough). Powers the live
# GitHub section. The username itself is configured in the database
# (site_settings.github_username).
GITHUB_TOKEN=

# Resend — contact form delivery.
RESEND_API_KEY=
# Where contact notifications are delivered. Defaults to contact@alexball.dev.
CONTACT_TO_EMAIL=
# Sender address; must be on a Resend-verified domain. Defaults to contact@alexball.dev.
CONTACT_FROM_EMAIL=

# Admin authentication (Clerk). All three or the admin stays switched off.
# Locally and in Preview: the Clerk DEVELOPMENT instance (pk_test / sk_test).
# Production: the Clerk PRODUCTION instance (pk_live / sk_live).
# Setup: docs/admin-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Your Clerk user ID (user_...) in that same instance; it differs between instances.
ADMIN_CLERK_USER_ID=
