# Server-only secret — never prefix with VITE_, never reaches the client bundle.
GITHUB_TOKEN=

# Server-only, non-secret — the GitHub username the API reports on.
GITHUB_USERNAME=

# Server-only, non-secret — comma-separated list of allowed CORS origins, shared by
# api/github.js and api/contact.js.
# Defaults to https://alexball.dev and http://localhost:5173 if unset.
ALLOWED_ORIGIN=

# Server-only secret — sends contact-form email via Resend. Never prefix with VITE_.
# Create at resend.com -> API Keys with "Sending access". Starts with `re_`.
RESEND_API_KEY=

# Server-only, non-secret — where contact-form notifications are delivered.
# Defaults to contact@alexball.dev if unset.
CONTACT_TO_EMAIL=contact@alexball.dev

# Server-only, non-secret — the sender address, which must live on a domain
# verified in Resend. Defaults to contact@alexball.dev if unset.
CONTACT_FROM_EMAIL=contact@alexball.dev

# Public — read by the client bundle (VITE_ prefix required by Vite to expose it).
# Defaults to https://api.alexball.dev if unset.
VITE_API_BASE_URL=
