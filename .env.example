# Server-only secret — never prefix with VITE_, never reaches the client bundle.
GITHUB_TOKEN=

# Server-only, non-secret — the GitHub username the API reports on.
GITHUB_USERNAME=

# Server-only, non-secret — comma-separated list of allowed CORS origins for api/github.js.
# Defaults to https://alexball.dev and http://localhost:5173 if unset.
ALLOWED_ORIGIN=

# Public — read by the client bundle (VITE_ prefix required by Vite to expose it).
# Defaults to https://api.alexball.dev if unset.
VITE_API_BASE_URL=
